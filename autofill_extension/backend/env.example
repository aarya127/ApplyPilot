NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional: separate model for free-text essays (more literal, fewer embellishments)
NVIDIA_NARRATIVE_MODEL=z-ai/glm-5.3
PORT=8000

# Absolute path to the resume PDF the extension attaches to Resume/CV inputs
RESUME_FILE_PATH=/absolute/path/to/your_resume.pdf
